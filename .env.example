# PostHog. Analytics is disabled entirely when the key is unset — the library is not
# even downloaded. The project API key is publishable and write-only, so it belongs in a
# repository variable rather than a secret.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# "memory" (default) stores nothing on the visitor's device, so no consent banner is
# needed — but every page load counts as a new anonymous visitor. Set to
# "localStorage+cookie" for accurate unique visitors; that requires consent in the EU.
NEXT_PUBLIC_POSTHOG_PERSISTENCE=memory
